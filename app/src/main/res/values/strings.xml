    <!-- Guide Method Contents (English) -->
    <string name="guide_kasuya_title">4:6 Method (Tetsu Kasuya)</string>
    <string name="guide_kasuya_subtitle">World Brewers Cup Champion 2016</string>
    <string name="guide_kasuya_tagline">Precise control over sweetness, acidity, and body strength</string>
    <string name="guide_kasuya_b1">5 Pours</string>
    <string name="guide_kasuya_b2">Coarse Grind</string>
    <string name="guide_kasuya_b3">88-92°C Temp</string>
    <string name="guide_kasuya_b4">1:15 Ratio</string>
    <string name="guide_kasuya_concept" formatted="false">Total water is divided into 40% and 60%:
• First 40% (2 pours): Controls sweetness vs acidity balance. A smaller first pour enhances sweetness.
• Second 60% (3 equal pours): Controls coffee strength and body.</string>
    <string name="guide_kasuya_technique">Use a coarse grind. Allow ~45-second intervals between pours, letting the water almost completely draw down before the next pour.</string>
    <string name="guide_kasuya_recommendation">Best suited for fruity &amp; floral single origin light roasts (e.g., Ethiopia, Kenya, Gesha).</string>

    <string name="guide_hoffmann_title">James Hoffmann Method (Ultimate V60)</string>
    <string name="guide_hoffmann_subtitle">World Barista Champion 2007</string>
    <string name="guide_hoffmann_tagline">Even extraction, high clarity, and sweet aftertaste without astringency</string>
    <string name="guide_hoffmann_b1">3 Phases + Swirl</string>
    <string name="guide_hoffmann_b2">Medium-Fine Grind</string>
    <string name="guide_hoffmann_b3">95-100°C Temp</string>
    <string name="guide_hoffmann_b4">1:16.6 Ratio</string>
    <string name="guide_hoffmann_concept" formatted="false">A scientific approach for consistently high extraction:
• Extensive Bloom: 2x to 3x coffee dose with gentle swirl to saturate all grounds.
• Phase 1: Spiral pour reaching 60% total water by 1:15.
• Phase 2: Gentle pour reaching 100% total water by 1:45.
• Finishing Swirl: Gentle stir and swirl for a perfectly flat coffee bed during drawdown.</string>
    <string name="guide_hoffmann_technique">Use high-temperature water (95-100°C for light roasts) to maximize extraction of sweet and acidic aromatics.</string>
    <string name="guide_hoffmann_recommendation">Ideal for high-density washed specialty coffees that thrive on high clarity.</string>

    <string name="guide_classic_title">Classic 3-Pour Method</string>
    <string name="guide_classic_subtitle">Gold Standard of Specialty Coffee Cafes</string>
    <string name="guide_classic_tagline">Most consistent, barista-friendly, and easy to reproduce every day</string>
    <string name="guide_classic_b1">3 Pours</string>
    <string name="guide_classic_b2">Medium Grind</string>
    <string name="guide_classic_b3">90-93°C Temp</string>
    <string name="guide_classic_b4">1:15 Ratio</string>
    <string name="guide_classic_concept">Three rhythmic, balanced pours:
• Bloom: 2x-3x coffee dose for 45 seconds to degas CO2.
• 2nd Pour: Circular spiral from center outward for middle extraction flavors.
• 3rd Pour: Steady center pour to maintain flow until complete drawdown.</string>
    <string name="guide_classic_technique">Keep gooseneck kettle spout low near water surface to avoid splashing and uncontrolled agitation.</string>
    <string name="guide_classic_recommendation">Highly versatile for all processing methods (Natural, Honey, Washed) from light to medium roasts.</string>

    <string name="guide_rao_title">Rao Single Pour Method (Scott Rao)</string>
    <string name="guide_rao_subtitle">Coffee Consultant &amp; Roasting Specialist Author</string>
    <string name="guide_rao_tagline">One continuous pour for thermal stability &amp; homogeneous extraction</string>
    <string name="guide_rao_b1">Single Pour</string>
    <string name="guide_rao_b2">Medium-Fine Grind</string>
    <string name="guide_rao_b3">92-95°C Temp</string>
    <string name="guide_rao_b4">1:16 Ratio</string>
    <string name="guide_rao_concept">Maintains constant slurry temperature and minimizes channeling:
• Bloom &amp; Excavation: Quick, gentle stir during bloom to eliminate dry pockets.
• Single Pour: Long, continuous, steady stream with zero pauses until target water is reached.
• Rao Spin: Swirl dripper gently near the end so coffee particles do not stick to the filter walls.</string>
    <string name="guide_rao_technique">Pour continuously from a consistent height. Avoid pouring directly against the paper filter walls.</string>
    <string name="guide_rao_recommendation">Delivers high extraction with a remarkably silky mouthfeel and deep sweetness.</string>

    <string name="guide_custom_title">Custom Method (Personal Experimentation)</string>
    <string name="guide_custom_subtitle">Limitless Barista Exploration</string>
    <string name="guide_custom_tagline">Design your own pouring stages, water ratios, and instructions</string>
    <string name="guide_custom_b1">Multi-Stage Freedom</string>
    <string name="guide_custom_b2">Flexible</string>
    <string name="guide_custom_b3">Auto-Balance Water</string>
    <string name="guide_custom_b4">Recipe Memory</string>
    <string name="guide_custom_concept" formatted="false">100% freedom to create your signature recipe:
• Freely add or remove pouring stages.
• Customize duration seconds, water grams, and stage instructions.
• \'Auto Balance Water\' button automatically balances remaining water to match your chosen ratio.</string>
    <string name="guide_custom_technique">Great for testing new variables such as bypass water, pulse pouring, or tiered water temperatures.</string>
    <string name="guide_custom_recommendation">Best for specialized fermentations (anaerobic, thermal shock, carbonic maceration) or competition routines.</string>

